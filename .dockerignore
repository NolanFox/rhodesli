# Git
.git
.gitignore

# Python
__pycache__
*.pyc
*.pyo
*.pyd
.Python
venv/
.venv/
env/
.env
*.egg-info/

# Development
.pytest_cache/
.coverage
htmlcov/
*.log
.DS_Store

# IDE
.vscode/
.idea/
*.swp
*.swo

# Documentation (not needed in container)
*.md
!CHANGELOG.md
docs/

# Tests (not needed in production)
tests/

# Notebooks (not needed in production)
notebooks/

# Heavy ML dependencies file (not used in production)
requirements-local.txt

# ML package large directories (not needed in production container)
# Only rhodesli_ml/graph/ and rhodesli_ml/importers/ are copied selectively
**/.venv/
rhodesli_ml/.venv/
rhodesli_ml/checkpoints/
rhodesli_ml/mlruns/
rhodesli_ml/tests/
rhodesli_ml/notebooks/

# Exclude backup/temp files from data bundle (saves ~400MB in image)
data/backups/
data/auto_backups/
data/cleanup_backups/
data/staging/
data/inbox/
data/*.bak*
data/*.preflight
data/comparison_results.json

# Raw photos are served from R2, not bundled
raw_photos/

# Local-only directories
data_backup_*/
test_photos_*/
uploads/
results/
mlruns/
logs/
evaluation/
